config {
  type: "table",
  schema: "walmart_training_tables",
  description: "walmart master table.",
  tags: ["intermediate", "master"],
  assertions: {
    nonNull: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
    uniqueKey: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
  }
}


  SELECT 
    -- context fields
    tgt.ctx_date_month,
    tgt.ctx_cat_id,
    tgt.ctx_dept_id,
    tgt.ctx_item_id,
    tgt.ctx_state_id,
    tgt.ctx_store_id,

    -- target fields
    tgt.tgt_monthly_sales * 3 AS tgt_benchmark,
    tgt.tgt_monthly_sales_sum_3_next_months,

    -- stockout filters
    stk.is_stockout,
    stk.is_stockout_tgt,

    -- encoded features
    enc.fea_is_foods,
    enc.fea_is_hobbies,
    enc.fea_is_household,
    enc.fea_dept_number,

    -- calendar features
    cal.fea_is_weekend_3m,
    cal.fea_is_event_3m,
    cal.fea_is_sporting_event_3m,
    cal.fea_is_cultural_event_3m,
    cal.fea_is_national_event_3m,

    -- longevity features
    long.fea_item_longevity_months

    -- price features
    price.fea_item_store_price_avg,
    price.fea_item_store_price_min,
    price.fea_item_store_price_max,
    price.fea_item_store_price_std,
    price.fea_dept_price_avg,
    price.fea_dept_price_min,
    price.fea_dept_price_max,
    price.fea_dept_price_std,
    price.fea_dept_unique_items,
    price.fea_price_pct_change_1m,
    price.fea_price_abs_change_1m,
    price.fea_item_vs_dept_price_ratio_avg,
    price.fea_item_vs_dept_price_ratio_min,
    price.fea_item_vs_dept_price_ratio_max,
    price.fea_item_vs_dept_price_ratio_std,
    
FROM ${ref("target_store_item_monthly")} tgt

-- join encoded features
LEFT JOIN ${ref("encoded_features")} enc
    ON enc.ctx_date_month = tgt.ctx_date_month
    AND enc.ctx_item_id = tgt.ctx_item_id
    AND enc.ctx_store_id = tgt.ctx_store_id
  
-- join calendar features
LEFT JOIN ${ref("calendar_features")} cal
    ON cal.ctx_date_month = tgt.ctx_date_month

-- join longevity feature
LEFT JOIN ${ref("item_longevity_features")} long
  ON long.ctx_date_month = tgt.ctx_date_month
  AND long.ctx_item_id = tgt.ctx_item_id

-- join price features
LEFT JOIN ${ref("price_features_ts")} price
    ON price.ctx_date_month = tgt.ctx_date_month
    AND price.ctx_item_id = tgt.ctx_item_id
    AND price.ctx_store_id = tgt.ctx_store_id

-- join filter_out_outliers
LEFT JOIN ${ref("stockout_filter")} stk
    ON stk.ctx_date_month = tgt.ctx_date_month
    AND stk.ctx_item_id = tgt.ctx_item_id
    AND stk.ctx_store_id = tgt.ctx_store_id

-- filter for store in scope
WHERE tgt.ctx_store_id = "CA_1"