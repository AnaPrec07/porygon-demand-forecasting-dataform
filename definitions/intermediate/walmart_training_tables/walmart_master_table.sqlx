    wea.fea_mean_snow_ice_pellets,
    wea.fea_mean_rain_drizzle,
    wea.fea_min_temperature,
    wea.fea_min_dewp,
    wea.fea_min_visib,
    wea.fea_min_wdsp,
    wea.fea_min_prcp,
    wea.fea_min_sndp,
    wea.fea_min_gust,
    wea.fea_min_fog,
    wea.fea_min_tornado_funnel_cloud,
    wea.fea_min_thunder,
