    hist_stckt.fea_dept_days_since_last_saleq50,
    hist_stckt.fea_dept_days_since_last_saleq75,
    hist_stckt.fea_dept_max_days_since_last_sale,
  
    -- rolling sales features
    fea_item_monthly_sales,
    fea_item_num_days_item_is_zero_sales,

    fea_sum_dept_monthly_sales,
    fea_min_dept_monthly_sales,
    fea_max_dept_monthly_sales,
    fea_stddev_dept_monthly_sales,
    fea_avg_dept_monthly_sales,
    fea_coeff_variation_dept_monthly_sales,
    fea_sum_dept_num_days_item_is_zero_sales,
    fea_min_dept_num_days_item_is_zero_sales,
    fea_max_dept_num_days_item_is_zero_sales,
    fea_stddev_dept_num_days_item_is_zero_sales,
    fea_avg_dept_num_days_item_is_zero_sales,
    fea_coeffvar_dept_num_days_item_is_zero_sales,

    fea_sum_cat_monthly_sales,
    fea_min_cat_monthly_sales,
    fea_max_cat_monthly_sales,
    fea_stddev_cat_monthly_sales,
    fea_avg_cat_monthly_sales,
    fea_coeff_variation_cat_monthly_sales,
    fea_sum_cat_num_days_item_is_zero_sales,
    fea_min_cat_num_days_item_is_zero_sales,
    fea_max_cat_num_days_item_is_zero_sales,
    fea_stddev_cat_num_days_item_is_zero_sales,
    fea_avg_cat_num_days_item_is_zero_sales,
    fea_coeffvar_cat_num_days_item_is_zero_sales,

