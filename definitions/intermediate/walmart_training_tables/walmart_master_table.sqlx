    fea_sum_cat_monthly_sales_roll_std_3_months,
    fea_sum_cat_monthly_sales_roll_min_3_months,
    fea_sum_cat_monthly_sales_roll_max_3_months,
    fea_sum_cat_monthly_sales_roll_count_3_months,
    fea_sum_cat_monthly_sales_roll_avg_6_months,
    fea_sum_cat_monthly_sales_roll_std_6_months,
    fea_sum_cat_monthly_sales_roll_min_6_months,
    fea_sum_cat_monthly_sales_roll_max_6_months,
    fea_sum_cat_monthly_sales_roll_count_6_months,
    fea_sum_cat_monthly_sales_roll_avg_12_months,
    fea_sum_cat_monthly_sales_roll_std_12_months,
    fea_sum_cat_monthly_sales_roll_min_12_months,
    fea_sum_cat_monthly_sales_roll_max_12_months,
    fea_sum_cat_monthly_sales_roll_count_12_months,
    fea_item_monthly_sales_ratio_lag_1_months,
    fea_item_monthly_sales_ratio_lag_2_months,
    fea_item_monthly_sales_ratio_lag_11_months, 
    fea_item_monthly_sales_roll_coeffvar_3_months,
    fea_item_monthly_sales_roll_coeffvar_6_months,
    fea_item_monthly_sales_roll_coeffvar_12_months,
    
FROM ${ref("target_store_item_monthly")} tgt

-- join encoded features
LEFT JOIN ${ref("encoded_features")} enc
    ON enc.ctx_date_month = tgt.ctx_date_month
    AND enc.ctx_item_id = tgt.ctx_item_id
    AND enc.ctx_store_id = tgt.ctx_store_id
  
-- join calendar features
LEFT JOIN ${ref("calendar_features")} cal
    ON cal.ctx_date_month = tgt.ctx_date_month

-- join calendar sales features
LEFT JOIN ${ref("calendar_sales_features")} cal_sales
    ON cal_sales.ctx_date_month = tgt.ctx_date_month
    AND cal_sales.ctx_item_id = tgt.ctx_item_id


-- join longevity feature
LEFT JOIN ${ref("item_longevity_features")} long
  ON long.ctx_date_month = tgt.ctx_date_month
  AND long.ctx_item_id = tgt.ctx_item_id

-- join price features
LEFT JOIN ${ref("price_features_ts")} price
    ON price.ctx_date_month = tgt.ctx_date_month
    AND price.ctx_item_id = tgt.ctx_item_id
    AND price.ctx_store_id = tgt.ctx_store_id

-- join weather features
LEFT JOIN ${ref("weather_features")} wea
    ON wea.ctx_date_month = tgt.ctx_date_month
    AND wea.ctx_state_id = tgt.ctx_state_id

-- join historical stockout features
LEFT JOIN ${ref("historical_stockout_features")} hist_stckt
    ON hist_stckt.ctx_date_month = tgt.ctx_date_month
    AND hist_stckt.ctx_item_id = tgt.ctx_item_id
    AND hist_stckt.ctx_store_id = tgt.ctx_store_id

-- join rolling sales features
LEFT JOIN ${ref("rolling_sales_features")} rolling_sales
  ON rolling_sales.ctx_date_month = tgt.ctx_date_month
  AND rolling_sales.ctx_item_id = tgt.ctx_item_id

-- join rolling timeseries sales features
LEFT JOIN ${ref("rolling_sales_ts_features")} rolling_ts_sales
  ON rolling_ts_sales.ctx_date_month = tgt.ctx_date_month
  AND rolling_ts_sales.ctx_item_id = tgt.ctx_item_id

-- join filter stockouts
LEFT JOIN ${ref("stockout_filter")} stk
    ON stk.ctx_date_month = tgt.ctx_date_month
    AND stk.ctx_item_id = tgt.ctx_item_id
    AND stk.ctx_store_id = tgt.ctx_store_id

-- filter for store in scope
WHERE tgt.ctx_store_id = "CA_1"