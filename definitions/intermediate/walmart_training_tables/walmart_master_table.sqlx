    cal_sales.feature_ratio_avg_sales_sport_event_roll_avg_6_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_std_6_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_min_6_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_max_6_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_count_6_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_avg_12_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_std_12_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_min_12_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_max_12_months,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_count_12_months,
    cal_sales.feature_avg_sales_cultural_event,
    cal_sales.feature_avg_sales_not_cultural_event,
    cal_sales.feature_ratio_avg_sales_cultural_event,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_avg_3_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_std_3_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_min_3_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_max_3_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_count_3_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_avg_6_months,
    cal_sales.feature_ratio_avg_sales_cultural_event_roll_std_6_months,
