    cal_sales.feature_ratio_avg_sales_snap_ca_roll_avg_12_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_std_12_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_min_12_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_max_12_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_count_12_months,


