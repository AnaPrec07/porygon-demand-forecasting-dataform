    hist_stckt.fea_item_days_since_last_saleq50,
    hist_stckt.fea_item_days_since_last_saleq75,
    hist_stckt.fea_item_max_days_since_last_sale,
    hist_stckt.fea_dept_min_daily_sales,
    hist_stckt.fea_dept_daily_salesq25,
