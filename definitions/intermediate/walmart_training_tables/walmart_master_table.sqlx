    cal_sales.feature_ratio_avg_sales_religious_event_roll_avg_6_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_std_6_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_min_6_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_max_6_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_count_6_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_avg_12_months,
