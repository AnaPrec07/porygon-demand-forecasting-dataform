    cal_sales.feature_ratio_avg_sales_religious_event_roll_min_12_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_max_12_months,
    cal_sales.feature_ratio_avg_sales_religious_event_roll_count_12_months,
    cal_sales.feature_avg_sales_snap_ca,
    cal_sales.feature_avg_sales_not_snap_ca,
    cal_sales.feature_ratio_avg_sales_snap_ca,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_avg_3_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_std_3_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_min_3_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_max_3_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_count_3_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_avg_6_months,
    cal_sales.feature_ratio_avg_sales_snap_ca_roll_std_6_months,
