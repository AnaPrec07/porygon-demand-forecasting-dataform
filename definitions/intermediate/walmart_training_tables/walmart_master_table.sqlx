config {
  type: "table",
  schema: "walmart_training_tables",
  description: "walmart master table.",
  tags: ["intermediate", "master"],
  assertions: {
    nonNull: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
    uniqueKey: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
  }
}


  SELECT 
    -- context fields
    tgt.ctx_date_month,
    tgt.ctx_cat_id,
    tgt.ctx_dept_id,
    tgt.ctx_item_id,
    tgt.ctx_state_id,
    tgt.ctx_store_id,

    -- target fields
    tgt.tgt_monthly_sales * 3 AS tgt_benchmark,
    tgt.tgt_monthly_sales_sum_3_next_months,

    -- stockout filters
    stk.is_stockout,
    stk.is_stockout_tgt,

    -- encoded features
    enc.fea_is_foods,
    enc.fea_is_hobbies,
    enc.fea_is_household,
    enc.fea_dept_number,

    -- calendar features
    cal.fea_is_weekend_3m,
