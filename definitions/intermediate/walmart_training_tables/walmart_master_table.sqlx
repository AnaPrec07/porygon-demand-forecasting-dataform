    cal.fea_is_sporting_event_3m,
    cal.fea_is_cultural_event_3m,
    cal.fea_is_national_event_3m,

    -- calendar sales features
    cal_sales.feature_avg_sales_sport_event,
    cal_sales.feature_avg_sales_not_sport_event,
    cal_sales.feature_ratio_avg_sales_sport_event,
    cal_sales.feature_ratio_avg_sales_sport_event_roll_avg_3_months,
