config {
  type: "assertion",
  name: "target_store_item_monthly__completeness",
  description: "Asserts that all expected (month, item, store) combinations exist in stockout_filter.",
  tags: ["intermediate", "target"],
}

-- Define the universe of expected (month, item, store) combinations
WITH universe AS (
  SELECT DISTINCT
    DATE_TRUNC(ctx_date, MONTH) AS ctx_date_month,
    ctx_item_id,
    ctx_store_id
  FROM ${ref("daily_sales_melted")}
  WHERE ctx_store_id = "CA_1"
),
actual AS (
  SELECT
    ctx_date_month,
    ctx_item_id,
    ctx_store_id
  FROM ${ref("target_store_item_monthly")}
  WHERE ctx_store_id = "CA_1"
)
SELECT
  u.ctx_date_month,
  u.ctx_item_id,
  u.ctx_store_id
FROM universe u
LEFT JOIN actual a
  ON u.ctx_date_month = a.ctx_date_month
  AND u.ctx_item_id = a.ctx_item_id
  AND u.ctx_store_id = a.ctx_store_id
WHERE a.ctx_date_month IS NULL
