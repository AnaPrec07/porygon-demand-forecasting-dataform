config {
  type: "assertion",
  description: "Check for missing (date, store, item) combinations in daily_sales_melted.",
  tags: ["intermediate", "stockout_filter"],
}

SELECT
  expected.ctx_date,
  expected.ctx_store_id,
  expected.item_id
FROM (
  SELECT
    cal.date AS ctx_date,
    s.store_id AS ctx_store_id,
    s.item_id AS ctx_item_id,
  FROM ${ref("calendar")} cal
  CROSS JOIN (SELECT DISTINCT store_id, item_id FROM ${ref("sales_train_validation")}) s
  WHERE cal.date <= "2016-04-24"
) expected
LEFT JOIN ${ref("daily_sales_melted")} actual
  ON expected.ctx_date = actual.ctx_date
  AND expected.ctx_store_id = actual.ctx_store_id
  AND expected.item_id = actual.ctx_item_id
WHERE actual.ctx_date IS NULL