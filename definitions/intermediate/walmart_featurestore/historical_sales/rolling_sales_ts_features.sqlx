config {
  type: "table",
  schema: "walmart_featurestore",
  description: "Rolling sales features time series per multiple hierarchy levels.",
  tags: ["intermediate", "walmart", "features", "historical_sales_ts"],
  assertions: {
    nonNull: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
    uniqueKey: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
  }
}

SELECT 
  ctx_item_id, 
  ctx_date_month,
  -- item level timeseries:
      -- lags: 12
      ${window_functions.generateLagColumns("fea_item_monthly_sales", maxLag=12)},
      -- general TS
      ${window_functions.generateRollAvgSTDEVPartition("fea_item_monthly_sales")},
  -- dept 
      ${window_functions.generateRollAvgSTDEVPartition("fea_sum_dept_monthly_sales")},
  -- cat
      ${window_functions.generateRollAvgSTDEVPartition("fea_sum_cat_monthly_sales")},
FROM ${ref("rolling_sales_features")} rolling 

