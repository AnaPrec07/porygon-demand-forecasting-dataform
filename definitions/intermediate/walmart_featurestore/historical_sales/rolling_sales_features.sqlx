config {
  type: "table",
  schema: "walmart_featurestore",
  description: "Rolling sales features per multiple hierarchy levels.",
  tags: ["intermediate", "walmart", "features", "historical_sales"],
  assertions: {
    nonNull: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
    uniqueKey: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
  }
}
WITH cleanned_targets AS (
  SELECT 
    tgt.ctx_date_month,
    tgt.ctx_store_id,
    tgt.ctx_item_id,
    tgt.ctx_cat_id,
    tgt.ctx_dept_id,
    tgt.ctx_state_id,
    tgt.tgt_monthly_sales,
    tgt.tgt_days_is_zero_sales
  FROM ${ref("target_store_item_monthly")} tgt 
  LEFT JOIN ${ref("item_longevity_features")} long
    ON long.ctx_item_id = tgt.ctx_item_id
    AND long.ctx_date_month = tgt.ctx_date_month
  LEFT JOIN ${ref("stockout_filter")} stockout
    ON stockout.ctx_date_month = tgt.ctx_date_month
    AND stockout.ctx_item_id = tgt.ctx_item_id
    AND stockout.ctx_store_id = tgt.ctx_store_id
  WHERE long.fea_item_longevity_months >=0
    AND tgt.ctx_store_id = "CA_1"
    AND stockout.is_stockout_tgt = 0
    AND tgt.ctx_date_month >"2011-01-01"

), 
item_sales AS (
  SELECT
  ctx_item_id,
  ctx_dept_id,
  ctx_cat_id,
  src.ctx_date_month,
  tgt_monthly_sales AS fea_item_monthly_sales,
  tgt_days_is_zero_sales AS fea_item_num_days_item_is_zero_sales,
  FROM cleanned_targets src
),
dept_sales AS (
  SELECT
    ctx_dept_id,
    ctx_date_month,
    -- Sales Amount
    SUM(fea_item_monthly_sales) AS fea_sum_dept_monthly_sales,
    MIN(fea_item_monthly_sales) AS fea_min_dept_monthly_sales,
    MAX(fea_item_monthly_sales) AS fea_max_dept_monthly_sales,
    STDDEV(fea_item_monthly_sales) AS fea_stddev_dept_monthly_sales,
    AVG(fea_item_monthly_sales) AS fea_avg_dept_monthly_sales,
    AVG(fea_item_monthly_sales)/STDDEV(fea_item_monthly_sales) AS fea_coeff_variation_dept_monthly_sales,
    -- Sales ittermitency
    SUM(fea_item_num_days_item_is_zero_sales) AS fea_sum_dept_num_days_item_is_zero_sales,
    MIN(fea_item_num_days_item_is_zero_sales) AS fea_min_dept_num_days_item_is_zero_sales,
    MAX(fea_item_num_days_item_is_zero_sales) AS fea_max_dept_num_days_item_is_zero_sales,
    STDDEV(fea_item_num_days_item_is_zero_sales) AS fea_stddev_dept_num_days_item_is_zero_sales,
    AVG(fea_item_num_days_item_is_zero_sales) AS fea_avg_dept_num_days_item_is_zero_sales,
    AVG(fea_item_num_days_item_is_zero_sales)/STDDEV(fea_item_num_days_item_is_zero_sales) AS fea_coeffvar_dept_num_days_item_is_zero_sales
  FROM item_sales
  GROUP BY 
    ctx_date_month,
    ctx_dept_id
),
cat_sales AS (
  SELECT
    ctx_cat_id,
    ctx_date_month,
    -- Sales Amount
    SUM(fea_item_monthly_sales) AS fea_sum_cat_monthly_sales,
    MIN(fea_item_monthly_sales) AS fea_min_cat_monthly_sales,
    MAX(fea_item_monthly_sales) AS fea_max_cat_monthly_sales,
    STDDEV(fea_item_monthly_sales) AS fea_stddev_cat_monthly_sales,
    AVG(fea_item_monthly_sales) AS fea_avg_cat_monthly_sales,
    AVG(fea_item_monthly_sales)/STDDEV(fea_item_monthly_sales) AS fea_coeff_variation_cat_monthly_sales,
    -- Sales ittermitency
    SUM(fea_item_num_days_item_is_zero_sales) AS fea_sum_cat_num_days_item_is_zero_sales,
    MIN(fea_item_num_days_item_is_zero_sales) AS fea_min_cat_num_days_item_is_zero_sales,
    MAX(fea_item_num_days_item_is_zero_sales) AS fea_max_cat_num_days_item_is_zero_sales,
    STDDEV(fea_item_num_days_item_is_zero_sales) AS fea_stddev_cat_num_days_item_is_zero_sales,
    AVG(fea_item_num_days_item_is_zero_sales) AS fea_avg_cat_num_days_item_is_zero_sales,
    AVG(fea_item_num_days_item_is_zero_sales)/STDDEV(fea_item_num_days_item_is_zero_sales) AS fea_coeffvar_cat_num_days_item_is_zero_sales
  FROM item_sales
  GROUP BY 
    ctx_date_month,
    ctx_cat_id
)
SELECT 
  -- item level features
  it.ctx_date_month,
  it.ctx_item_id,
  it.ctx_dept_id,
  it.ctx_cat_id,
  it.fea_item_monthly_sales,
  it.fea_item_num_days_item_is_zero_sales,

  -- dept level features
  dept.fea_sum_dept_monthly_sales,
  dept.fea_min_dept_monthly_sales,
  dept.fea_max_dept_monthly_sales,
  dept.fea_stddev_dept_monthly_sales,
  dept.fea_avg_dept_monthly_sales,
  dept.fea_coeff_variation_dept_monthly_sales,
  dept.fea_sum_dept_num_days_item_is_zero_sales,
  dept.fea_min_dept_num_days_item_is_zero_sales,
  dept.fea_max_dept_num_days_item_is_zero_sales,
  dept.fea_stddev_dept_num_days_item_is_zero_sales,
  dept.fea_avg_dept_num_days_item_is_zero_sales,
  dept.fea_coeffvar_dept_num_days_item_is_zero_sales,

  -- cat level features
  cat.fea_sum_cat_monthly_sales,
  cat.fea_min_cat_monthly_sales,
  cat.fea_max_cat_monthly_sales,
  cat.fea_stddev_cat_monthly_sales,
  cat.fea_avg_cat_monthly_sales,
  cat.fea_coeff_variation_cat_monthly_sales,
  cat.fea_sum_cat_num_days_item_is_zero_sales,
  cat.fea_min_cat_num_days_item_is_zero_sales,
  cat.fea_max_cat_num_days_item_is_zero_sales,
  cat.fea_stddev_cat_num_days_item_is_zero_sales,
  cat.fea_avg_cat_num_days_item_is_zero_sales,
  cat.fea_coeffvar_cat_num_days_item_is_zero_sales,

  -- Dept Ratios
  SAFE_DIVIDE(it.fea_item_monthly_sales, dept.fea_sum_dept_monthly_sales) AS fea_ratio_item_dept_sum_monthly_sales,
  SAFE_DIVIDE(it.fea_item_monthly_sales, dept.fea_min_dept_monthly_sales) AS fea_ratio_item_dept_min_monthly_sales,
  SAFE_DIVIDE(it.fea_item_monthly_sales, dept.fea_max_dept_monthly_sales) AS fea_ratio_item_dept_max_monthly_sales,
  SAFE_DIVIDE(it.fea_item_monthly_sales, dept.fea_avg_dept_monthly_sales) fea_ratio_item_dept_avg_monthly_sales,
  SAFE_DIVIDE(it.fea_item_num_days_item_is_zero_sales, dept.fea_sum_dept_num_days_item_is_zero_sales) AS fea_ratio_item_dept_sum_num_days_item_is_zero_sales,
  SAFE_DIVIDE(it.fea_item_num_days_item_is_zero_sales, dept.fea_min_dept_num_days_item_is_zero_sales) AS fea_ratio_item_dept_min_num_days_item_is_zero_sales,
  SAFE_DIVIDE(it.fea_item_num_days_item_is_zero_sales, dept.fea_max_dept_num_days_item_is_zero_sales) AS fea_ratio_item_dept_max_num_days_item_is_zero_sales,
  SAFE_DIVIDE(it.fea_item_num_days_item_is_zero_sales, dept.fea_avg_dept_num_days_item_is_zero_sales)  AS fea_ratio_item_dept_avg_num_days_item_is_zero_sales,

FROM item_sales it 
LEFT JOIN dept_sales dept
  ON dept.ctx_date_month = it.ctx_date_month
  AND dept.ctx_dept_id = it.ctx_dept_id
LEFT JOIN cat_sales cat
  ON cat.ctx_date_month = it.ctx_date_month
  AND cat.ctx_cat_id = it.ctx_cat_id
