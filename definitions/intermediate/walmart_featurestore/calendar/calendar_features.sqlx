config {
  type: "table",
  schema: "walmart_featurestore",
  description: "Calendar features.",
  tags: ["intermediate", "walmart", "features", "calendar"],
  assertions: {
    nonNull: [
      "ctx_date_month",
    ],
    uniqueKey: [
      "ctx_date_month",
    ],
  }
}

WITH intermediate_aggregations AS (
  SELECT 
    DATE_TRUNC(date, MONTH) AS ctx_date_month,
    CAST(weekday IN ("Sunday","Saturday") AS INT64) AS is_weekend,
    ((CAST(event_name_1 IS NOT NULL AS INT64)) +  (CAST(event_name_1 IS NOT NULL AS INT64))) AS is_event,
    SIN(2 * ACOS(-1) * EXTRACT(MONTH FROM date) / 12) AS fea_month_sin,
    CASE 
      WHEN event_type_1 = "Sporting" OR event_type_2 = "Sporting"
        THEN 1
      ELSE 0
    END is_sporting_event,
    CASE 
      WHEN event_type_1 = "Cultural" OR event_type_2 = "Cultural"
        THEN 1
      ELSE 0
    END is_cultural_event,
    CASE 
      WHEN event_type_1 = "National" OR event_type_2 = "National"
        THEN 1
      ELSE 0
    END is_national_event,
    CASE 
      WHEN event_type_1 = "Religious" OR event_type_2 = "Religious"
        THEN 1
      ELSE 0
    END is_religious_event,
    CASE 
      WHEN event_name_1 IN (
          "Christmas",
          "ValentinesDay",
          "Mother’s day",
          "Father’s day",
          "Easter",
          "Chanukah End",
          "OrthodoxChristmas"
      ) 
        OR event_name_2 IN (
          "Christmas",
          "ValentinesDay",
          "Mother’s day",
          "Father’s day",
          "Easter",
          "Chanukah End",
          "OrthodoxChristmas"
        )
        THEN 1
      ELSE 0
    END is_gift_driven_event,
  FROM ${ref("calendar")}
),
events_at_monthly_level AS (
SELECT 
  ctx_date_month, 
  SUM(is_weekend) AS fea_is_weekend,
  SUM(is_event) AS fea_is_event,
  SUM(is_sporting_event) AS fea_is_sporting_event,
  SUM(is_cultural_event) AS fea_is_cultural_event,
  SUM(is_national_event) AS fea_is_national_event,
  SUM(is_religious_event) AS fea_is_religious_event,
  SUM(is_gift_driven_event) AS fea_is_gift_driven_event,
  fea_month_sin,
FROM intermediate_aggregations
GROUP BY 
    ctx_date_month, 
    fea_month_sin
)
SELECT
  ctx_date_month,
  fea_is_religious_event,
  SUM(fea_is_weekend) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_weekend_3m,
  SUM(fea_is_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_event_3m,
  SUM(fea_is_sporting_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_sporting_event_3m,
  SUM(fea_is_cultural_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_cultural_event_3m,
  SUM(fea_is_national_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_national_event_3m,
  SUM(fea_is_religious_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_religious_event_3m,
  SUM(fea_is_gift_driven_event) OVER (
    ORDER BY ctx_date_month 
    ROWS BETWEEN 1 FOLLOWING AND 3 FOLLOWING
  ) AS fea_is_gift_driven_event_3m,
  FROM events_at_monthly_level

