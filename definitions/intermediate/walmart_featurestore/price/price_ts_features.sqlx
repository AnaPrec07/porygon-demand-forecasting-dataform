config {
  type: "table",
  schema: "walmart_featurestore",
  description: "Price features with time series rolling averages at multiple hierarchy levels.",
  tags: ["intermediate", "walmart", "features", "price"],
  assertions: {
    nonNull: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
    uniqueKey: [
      "ctx_date_month",
      "ctx_item_id",
      "ctx_store_id",
    ],
  }
}

SELECT
    ctx_date_month,
    ctx_item_id, 
    ctx_store_id,
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_store_price_min")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_store_price_avg")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_store_price_max")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_store_price_std")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_dept_price_avg")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_dept_price_min")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_dept_price_max")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_dept_price_std")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_dept_unique_items")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_vs_dept_price_ratio_avg")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_vs_dept_price_ratio_min")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_vs_dept_price_ratio_max")},
    ${window_functions.generateRollAvgSTDEVPartition("fea_item_vs_dept_price_ratio_std")},
FROM ${ref("price_features")}